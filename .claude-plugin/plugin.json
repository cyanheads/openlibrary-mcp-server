{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "openlibrary-mcp-server",
  "version": "0.3.1",
  "description": "Search books and authors, fetch editions, browse subjects, and resolve cover images from Open Library via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/openlibrary-mcp-server#readme",
  "repository": "https://github.com/cyanheads/openlibrary-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "open-library", "books", "authors", "isbn"],
  "userConfig": {
    "clamp_limits": {
      "type": "boolean",
      "title": "Clamp oversized requests",
      "description": "Apply page and identifier batch limits with continuation guidance. Disable to reject oversized requests.",
      "required": false,
      "default": true
    }
  },
  "mcpServers": {
    "openlibrary-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/openlibrary-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "OPENLIBRARY_CLAMP_LIMITS": "${user_config.clamp_limits}"
      }
    }
  }
}
